- */
-
-while ((c = getopt (argc, argv, OPTFLAGS)) != EOF) {
-switch (c) {
-case 'w':
-wflg = atoi (optarg);
-break;
-case 's':
-sflg = atoi (optarg);
-break;
-case 'd':
-dflg = atoi (optarg);
-break;
-case 'S':
-Sflg = atoi (optarg);
-break;
-case '?': /* illegal option? */
-errflg++;
-break;
-}
-}
-if (errflg || (argc-optind) != 0) {
-(void) printf ("empire: usage: empire [-w water] [-s smooth] [-d delay]\n");
