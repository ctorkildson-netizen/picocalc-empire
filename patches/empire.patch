 /*
-main.c -- parse command line for empire
+main.c -- entry point for empire
 
-options:
-
-    -w water: percentage of map that is water.  Must be in the range
-              10..90.  Default is 70.
-      
-    -s smooth: amount of smoothing performed to generate map.  Must
-       be a nonnegative integer.  Default is 5.
-       
-    -d delay:  number of milliseconds to delay between output.
-               default is 2000 (2 seconds).
-
-    -S saveinterval: sets turn interval between saves.
-       default is 10
+PicoCalc port: there is no argv on a microcontroller, and the Pico SDK's
+C library doesn't provide getopt(), so the original -w/-s/-d/-S command
+line option parsing has been replaced with the same fixed defaults the
+original used when no flags were given at all. main() has also been
+renamed to empire_main() so a hardware-specific main.c elsewhere in the
+project can call into it after doing PicoCalc hardware setup.
 */
 
-#include <stdio.h>
